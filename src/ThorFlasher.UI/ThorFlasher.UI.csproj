<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>ThorFlasher</AssemblyName>
    <RootNamespace>ThorFlasher.UI</RootNamespace>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ThorFlasher.Core\ThorFlasher.Core.csproj" />
    <ProjectReference Include="..\ThorFlasher.Adapters\ThorFlasher.Adapters.csproj" />
    <ProjectReference Include="..\ThorFlasher.Infrastructure\ThorFlasher.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Include Thor_Script folder in publish output -->
  <ItemGroup>
    <Content Include="..\..\Thor_Script\**\*" LinkBase="Thor_Script" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
