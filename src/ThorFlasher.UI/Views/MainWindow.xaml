<Window x:Class="ThorFlasher.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ThorFlasher"
        Width="980"
        Height="720"
        MinWidth="860"
        MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock FontSize="26"
                       FontWeight="SemiBold"
                       Text="ThorFlasher" />
            <TextBlock Margin="0,4,0,14"
                       Foreground="#555555"
                       Text="Select a .bin or .cap file, configure the THOR endpoints, then start the operation." />

            <GroupBox Header="Target Configuration">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Margin="0,6,12,6"
                               VerticalAlignment="Center"
                               Text="THOR Host IP" />
                    <TextBox Grid.Row="0"
                             Grid.Column="1"
                             Margin="0,4,0,4"
                             IsEnabled="{Binding CanEditInputs}"
                             Text="{Binding HostIp, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Margin="0,6,12,6"
                               VerticalAlignment="Center"
                               Text="THOR Target IP" />
                    <TextBox Grid.Row="1"
                             Grid.Column="1"
                             Margin="0,4,0,4"
                             IsEnabled="{Binding CanEditInputs}"
                             Text="{Binding TargetIp, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Margin="0,6,12,6"
                               VerticalAlignment="Center"
                               Text="Firmware/Capsule File" />
                    <Border Grid.Row="2"
                            Grid.Column="1"
                            Margin="0,4,0,4"
                            Padding="8"
                            BorderBrush="#8A99A8"
                            BorderThickness="1.5"
                            Background="#F7F9FB"
                            CornerRadius="6"
                            AllowDrop="True"
                            PreviewDragOver="DropZone_PreviewDragOver"
                            Drop="DropZone_Drop">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top"
                                       Margin="0,0,0,4"
                                       Foreground="#53606D"
                                       Text="Drag and drop one .bin or .cap file here, or use Browse." />
                            <TextBox IsEnabled="{Binding CanEditInputs}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                    </Border>
                    <Button Grid.Row="2"
                            Grid.Column="2"
                            Margin="8,4,0,4"
                            Command="{Binding BrowseCommand}"
                            Content="Browse" />

                    <TextBlock Grid.Row="3"
                               Grid.Column="0"
                               Margin="0,6,12,6"
                               VerticalAlignment="Center"
                               Text="Operation Type" />
                    <TextBox Grid.Row="3"
                             Grid.Column="1"
                             Margin="0,4,0,4"
                             IsReadOnly="True"
                             Text="{Binding DetectedOperationDisplay, Mode=OneWay}" />

                    <TextBlock Grid.Row="4"
                               Grid.Column="0"
                               Margin="0,6,12,6"
                               VerticalAlignment="Center"
                               Text="Status" />
                    <Border Grid.Row="4"
                            Grid.Column="1"
                            Margin="0,4,0,4"
                            Padding="8,6"
                            Background="#F2F4F7"
                            BorderBrush="#D6DCE5"
                            BorderThickness="1"
                            CornerRadius="4">
                        <TextBlock Text="{Binding Status}" />
                    </Border>
                </Grid>
            </GroupBox>
        </StackPanel>

        <GroupBox Grid.Row="1" Header="Live Log">
            <Grid>
                <ListBox x:Name="LogListBox"
                         ItemsSource="{Binding LogEntries}"
                         DisplayMemberPath="DisplayText"
                         FontFamily="Consolas"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Command="{Binding SaveEnvironmentCommand}"
                    Content="Save Environment" />
            <Button Command="{Binding LoadEnvironmentCommand}"
                    Content="Load Environment" />
            <Button Command="{Binding StartCommand}"
                    Background="#DDF3E4"
                    Content="Start" />
            <Button Command="{Binding CancelCommand}"
                    Background="#FCE8E6"
                    Content="Cancel" />
            <Button Margin="0,0,0,0"
                    Command="{Binding ClearLogCommand}"
                    Content="Clear Log" />
        </StackPanel>
    </Grid>
</Window>
