<UserControl x:Class="ThorFlasher.UI.Views.Pages.SetupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ThorFlasher.UI.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <controls:SectionCard Margin="0,0,0,18"
                                  Subtitle="Configure the THOR host and target addresses.">
                <controls:SectionCard.Header>
                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}"
                               Text="Connection" />
                </controls:SectionCard.Header>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabelTextStyle}"
                                   Text="THOR Host IP" />
                        <TextBox IsEnabled="{Binding CanEditInputs}"
                                 Text="{Binding HostIp, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Margin="0,18,0,0">
                        <TextBlock Style="{StaticResource FieldLabelTextStyle}"
                                   Text="THOR Target IP" />
                        <TextBox IsEnabled="{Binding CanEditInputs}"
                                 Text="{Binding TargetIp, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>
            </controls:SectionCard>

            <controls:SectionCard Margin="0,0,0,18"
                                  Subtitle="Drop a package here or browse to a local file.">
                <controls:SectionCard.Header>
                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}"
                               Text="Package" />
                </controls:SectionCard.Header>

                <Border x:Name="DropZoneBorder"
                        Style="{StaticResource DropZoneBorderStyle}"
                        AllowDrop="True"
                        PreviewDragOver="DropZone_PreviewDragOver"
                        DragEnter="DropZone_DragEnter"
                        DragLeave="DropZone_DragLeave"
                        Drop="DropZone_Drop">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Width="52"
                                Height="52"
                                HorizontalAlignment="Left"
                                Background="{StaticResource Brush.AccentMuted}"
                                BorderBrush="{StaticResource Brush.BorderStrong}"
                                BorderThickness="1"
                                CornerRadius="26">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="20"
                                       Foreground="{StaticResource Brush.Accent}"
                                       Text="{StaticResource Icon.Upload}" />
                        </Border>

                        <TextBlock Grid.Row="1"
                                   Margin="0,16,0,0"
                                   Style="{StaticResource ValueTextStyle}"
                                   Text="Drag and drop one .bin or .cap package" />
                        <TextBlock Grid.Row="2"
                                   Margin="0,6,0,0"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Text="Supported formats: .bin firmware packages and .cap capsule packages" />

                        <Border Grid.Row="3"
                                Margin="0,18,0,0"
                                Style="{StaticResource InsetPanelBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox Background="Transparent"
                                         BorderThickness="0"
                                         FontFamily="{StaticResource FontFamily.Console}"
                                         IsEnabled="{Binding CanEditInputs}"
                                         Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}" />

                                <Button Grid.Column="2"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        Command="{Binding BrowseCommand}"
                                        Content="Browse" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </controls:SectionCard>

            <controls:SectionCard Margin="0,0,0,18"
                                  Subtitle="Store or restore common connection and package presets.">
                <controls:SectionCard.Header>
                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}"
                               Text="Environment" />
                </controls:SectionCard.Header>

                <StackPanel>
                    <Border Style="{StaticResource InsetPanelBorderStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CaptionTextStyle}"
                                       Text="Current Profile" />
                            <TextBlock Margin="0,6,0,0"
                                       Style="{StaticResource ValueTextStyle}"
                                       Text="{Binding CurrentProfileNameDisplay}" />
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource SecondaryActionButtonStyle}"
                                Command="{Binding SaveEnvironmentCommand}"
                                Content="Save Environment" />
                        <Button Grid.Column="2"
                                Style="{StaticResource SubtleButtonStyle}"
                                Command="{Binding LoadEnvironmentCommand}"
                                Content="Load Environment" />
                    </Grid>
                </StackPanel>
            </controls:SectionCard>

            <Border Style="{StaticResource InsetPanelBorderStyle}"
                    Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource CaptionTextStyle}"
                                   Text="Setup Summary" />
                        <TextBlock Margin="0,4,0,0"
                                   Style="{StaticResource ValueTextStyle}"
                                   Text="{Binding SetupSummaryText}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            Command="{Binding GoToOperationCommand}"
                            Content="Continue to Operation" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>