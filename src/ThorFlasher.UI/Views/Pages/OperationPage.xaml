<UserControl x:Class="ThorFlasher.UI.Views.Pages.OperationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ThorFlasher.UI.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <controls:SectionCard Margin="0,0,0,18"
                                  Subtitle="Review the active package, target, and current execution state before running an operation.">
                <controls:SectionCard.Header>
                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}"
                               Text="Execution Overview" />
                </controls:SectionCard.Header>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <controls:InfoRow Label="THOR Host"
                                          Value="{Binding HostSummaryDisplay}" />
                        <controls:InfoRow Label="THOR Target"
                                          Value="{Binding TargetSummaryDisplay}" />
                        <controls:InfoRow Label="Package"
                                          Value="{Binding SelectedFileNameDisplay}" />
                        <controls:InfoRow Label="Environment"
                                          Value="{Binding CurrentProfileNameDisplay}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                HorizontalAlignment="Right">
                        <Border Margin="0,18,0,0"
                                Padding="16"
                                Background="{StaticResource Brush.WarningMuted}"
                                BorderBrush="{StaticResource Brush.Warning}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Medium}">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Warning}"
                                           Text="Safety Check" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Text="Review the selected package and target before executing Flash or Capsule Update." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </controls:SectionCard>

            <controls:SectionCard Subtitle="These operations will execute existing THOR scripts without changing the backend workflow.">
                <controls:SectionCard.Header>
                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}"
                               Text="Actions" />
                </controls:SectionCard.Header>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            Command="{Binding FlashCommand}"
                            Content="Flash" />
                    <Button Grid.Column="2"
                            Style="{StaticResource SecondaryActionButtonStyle}"
                            Command="{Binding CapsuleUpdateCommand}"
                            Content="Capsule Update" />
                </Grid>
            </controls:SectionCard>

            <Border Style="{StaticResource InsetPanelBorderStyle}"
                    Margin="0,18,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Style="{StaticResource SubtleButtonStyle}"
                            Command="{Binding GoToSetupCommand}"
                            Content="Back to Setup" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>