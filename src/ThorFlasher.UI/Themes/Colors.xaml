<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.AppBackground">#0B1117</Color>
    <Color x:Key="Color.ChromeBackground">#0F1720</Color>
    <Color x:Key="Color.Surface">#141E29</Color>
    <Color x:Key="Color.SurfaceAlt">#192532</Color>
    <Color x:Key="Color.SurfaceInset">#0A121A</Color>
    <Color x:Key="Color.SurfaceHover">#1E2B39</Color>
    <Color x:Key="Color.Border">#26374A</Color>
    <Color x:Key="Color.BorderStrong">#365269</Color>
    <Color x:Key="Color.Accent">#4CC9F0</Color>
    <Color x:Key="Color.AccentStrong">#38BDF8</Color>
    <Color x:Key="Color.AccentMuted">#0F2F43</Color>
    <Color x:Key="Color.Success">#2FBF71</Color>
    <Color x:Key="Color.SuccessMuted">#113323</Color>
    <Color x:Key="Color.Warning">#F4B942</Color>
    <Color x:Key="Color.WarningMuted">#3D2D11</Color>
    <Color x:Key="Color.Error">#E26D5A</Color>
    <Color x:Key="Color.ErrorMuted">#3B1B19</Color>
    <Color x:Key="Color.Info">#60A5FA</Color>
    <Color x:Key="Color.InfoMuted">#13263D</Color>
    <Color x:Key="Color.TextPrimary">#F5F7FA</Color>
    <Color x:Key="Color.TextSecondary">#B7C2D0</Color>
    <Color x:Key="Color.TextMuted">#7D8A9A</Color>
    <Color x:Key="Color.TextOnAccent">#041019</Color>
    <Color x:Key="Color.Disabled">#5C6A79</Color>

    <SolidColorBrush x:Key="Brush.AppBackground" Color="{StaticResource Color.AppBackground}" />
    <SolidColorBrush x:Key="Brush.ChromeBackground" Color="{StaticResource Color.ChromeBackground}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{StaticResource Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="Brush.SurfaceInset" Color="{StaticResource Color.SurfaceInset}" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{StaticResource Color.SurfaceHover}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentStrong" Color="{StaticResource Color.AccentStrong}" />
    <SolidColorBrush x:Key="Brush.AccentMuted" Color="{StaticResource Color.AccentMuted}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.SuccessMuted" Color="{StaticResource Color.SuccessMuted}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.WarningMuted" Color="{StaticResource Color.WarningMuted}" />
    <SolidColorBrush x:Key="Brush.Error" Color="{StaticResource Color.Error}" />
    <SolidColorBrush x:Key="Brush.ErrorMuted" Color="{StaticResource Color.ErrorMuted}" />
    <SolidColorBrush x:Key="Brush.Info" Color="{StaticResource Color.Info}" />
    <SolidColorBrush x:Key="Brush.InfoMuted" Color="{StaticResource Color.InfoMuted}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.TextOnAccent" Color="{StaticResource Color.TextOnAccent}" />
    <SolidColorBrush x:Key="Brush.Disabled" Color="{StaticResource Color.Disabled}" />
</ResourceDictionary>
