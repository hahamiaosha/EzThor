<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:ThorFlasher.UI.Controls">
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource Brush.AppBackground}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Ui}" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="Background" Value="{StaticResource Brush.SurfaceAlt}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight.Standard}" />
        <Setter Property="CaretBrush" Value="{StaticResource Brush.Accent}" />
        <Setter Property="Margin" Value="0" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.72" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="RichTextBox">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="Background" Value="{StaticResource Brush.SurfaceInset}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="Background" Value="{StaticResource Brush.SurfaceAlt}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight.Standard}" />
        <Setter Property="MinWidth" Value="104" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Medium}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.92" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextOnAccent}" />
        <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.AccentStrong}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight.Large}" />
    </Style>

    <Style x:Key="SecondaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource Brush.InfoMuted}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Info}" />
    </Style>

    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource Brush.ErrorMuted}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Error}" />
    </Style>

    <Style x:Key="SubtleButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
    </Style>

    <Style TargetType="ListView">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="Background" Value="{StaticResource Brush.SurfaceAlt}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style TargetType="ListViewItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.AccentMuted}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="GridViewColumnHeader">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="DropZoneBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.SurfaceAlt}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1.4" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Large}" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="InsetPanelBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.SurfaceInset}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Medium}" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <Style TargetType="{x:Type controls:SectionCard}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SectionCard}">
                    <Border Background="{StaticResource Brush.Surface}"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Large}"
                            Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <ContentPresenter ContentSource="Header" />
                                <TextBlock x:Name="SubtitleText"
                                           Margin="0,6,0,0"
                                           Style="{StaticResource SectionSubtitleTextStyle}"
                                           Text="{TemplateBinding Subtitle}" />
                            </StackPanel>

                            <ContentPresenter Grid.Row="1"
                                              Margin="0,18,0,0"
                                              ContentSource="Content" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Subtitle" Value="">
                            <Setter TargetName="SubtitleText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:StatusBadge}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:StatusBadge}">
                    <Border x:Name="BadgeBorder"
                            Padding="12,6"
                            Background="{StaticResource Brush.SurfaceAlt}"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Medium}">
                        <TextBlock x:Name="BadgeText"
                                   Text="{TemplateBinding Text}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.TextSecondary}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="Idle">
                            <Setter TargetName="BadgeBorder" Property="Background" Value="{StaticResource Brush.SurfaceAlt}" />
                        </Trigger>
                        <Trigger Property="Text" Value="Ready">
                            <Setter TargetName="BadgeBorder" Property="Background" Value="{StaticResource Brush.InfoMuted}" />
                            <Setter TargetName="BadgeBorder" Property="BorderBrush" Value="{StaticResource Brush.Info}" />
                            <Setter TargetName="BadgeText" Property="Foreground" Value="{StaticResource Brush.Info}" />
                        </Trigger>
                        <Trigger Property="Text" Value="Running">
                            <Setter TargetName="BadgeBorder" Property="Background" Value="{StaticResource Brush.AccentMuted}" />
                            <Setter TargetName="BadgeBorder" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            <Setter TargetName="BadgeText" Property="Foreground" Value="{StaticResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="Text" Value="Success">
                            <Setter TargetName="BadgeBorder" Property="Background" Value="{StaticResource Brush.SuccessMuted}" />
                            <Setter TargetName="BadgeBorder" Property="BorderBrush" Value="{StaticResource Brush.Success}" />
                            <Setter TargetName="BadgeText" Property="Foreground" Value="{StaticResource Brush.Success}" />
                        </Trigger>
                        <Trigger Property="Text" Value="Failed">
                            <Setter TargetName="BadgeBorder" Property="Background" Value="{StaticResource Brush.ErrorMuted}" />
                            <Setter TargetName="BadgeBorder" Property="BorderBrush" Value="{StaticResource Brush.Error}" />
                            <Setter TargetName="BadgeText" Property="Foreground" Value="{StaticResource Brush.Error}" />
                        </Trigger>
                        <Trigger Property="Text" Value="Cancelled">
                            <Setter TargetName="BadgeBorder" Property="Background" Value="{StaticResource Brush.WarningMuted}" />
                            <Setter TargetName="BadgeBorder" Property="BorderBrush" Value="{StaticResource Brush.Warning}" />
                            <Setter TargetName="BadgeText" Property="Foreground" Value="{StaticResource Brush.Warning}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:InfoRow}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:InfoRow}">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource FieldLabelTextStyle}"
                                   Margin="0,0,16,0"
                                   Text="{TemplateBinding Label}" />
                        <TextBlock Grid.Column="1"
                                   Style="{StaticResource ValueTextStyle}"
                                   Text="{TemplateBinding Value}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
