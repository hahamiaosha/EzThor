{
  "ThorScriptSettings": {
    "ScriptsRootPath": "Thor_Script",
    "SendBuildScriptRelativePath": "send_build.sh",
    "FlashScriptRelativePath": "flash.sh",
    "CapsuleScriptRelativePath": "Send_Cap_and_Update.sh",
    "IpConfigFileRelativePath": "env/target_config.sh",
    "HostIpToken": "{{HOST_IP}}",
    "TargetIpToken": "{{TARGET_IP}}",
    "SelectedFileToken": "{{SELECTED_FILE_PATH}}",
    "HostUserToken": "{{HOST_USER}}",
    "HostPasswordToken": "{{HOST_PASSWORD}}",
    "TargetUserToken": "{{TARGET_USER}}",
    "TargetPasswordToken": "{{TARGET_PASSWORD}}"
  },
  "ScriptExecutionSettings": {
    "ShellExecutable": "bash.exe",
    "ShellArgumentsTemplate": "{scriptPath} {args}",
    "SendBuildArgumentsTemplate": "",
    "FlashArgumentsTemplate": "--mode {flashMode} --slot {flashSlot} --storage {flashStorage}",
    "CapsuleArgumentsTemplate": "--host {hostIp} --build-user {hostUser} --build-pass {hostPassword} --thor-host {targetIp} --thor-user {targetUser} --thor-pass {targetPassword}",
    "TranslateWindowsPathsForWsl": false
  }
}
